# Copy to .env and fill in. Never commit .env.

# AI (Groq is the main model, OpenAI is the fallback and is used for CMR scans)
GROQ_API_KEY=
OPENAI_API_KEY=

# Gmail over IMAP (use an App Password, not the account password)
EMAIL=
EMAIL_PASSWORD=
EMAIL_FOLDER=logistics

# Google Sheets and Drive (IDs from the URLs)
LOADS_INFO_SHEET_ID=
PAYMENT_PLAN_SHEET_ID=
DRIVE_ROOT_FOLDER_ID=

# Telegram (optional, for CMR photos)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Folder where WhatsApp Desktop saves CMR files (optional)
DOWNLOADS_WATCH_FOLDER=

# SaldeoSMART API (experimental module saldeo_client.py)
SALDEO_BASE_URL=https://saldeo-test.brainshare.pl
SALDEO_USERNAME=
SALDEO_API_TOKEN=
SALDEO_COMPANY_PROGRAM_ID=
